#!/bin/sh
# Usage: setup-runtime
# Installs the runtime fixture as a library source in a fresh directory,
# projects its entry skill into isolated Claude Code and Codex homes, and
# prints the directory.
set -eu
here=$(cd "$(dirname "$0")" && pwd -P)
henia=$(command -v henia)
w=$(cd "$(mktemp -d)" && pwd -P)
mkdir -p "$w/data/henia/sources" "$w/home/claude" "$w/home/codex" "$w/project" "$w/zdotdir" "$w/home/codex/rules"
cp -R "$here/runtime/source" "$w/data/henia/sources/fixture"
printf '%s\n' 'prefix_rule(pattern=["henia", "show"], decision="allow")' 'prefix_rule(pattern=["henia", "preload"], decision="allow")' > "$w/home/codex/rules/henia.rules"
"$henia" build "$w/data/henia/sources/fixture" --output "$w/build" > /dev/null
cp -R "$w/build/claude/skills" "$w/home/claude/skills"
cp -R "$w/build/codex/skills" "$w/home/codex/skills"
git -C "$w/project" init -q
printf '%s\n' "$w"
